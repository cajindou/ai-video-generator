.vip-page{min-height:100vh;background:-webkit-linear-gradient(315deg,#667eea 0%,#764ba2 100%);background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);padding:40rpx 30rpx 200rpx}.header{text-align:center;margin-bottom:60rpx}.title{display:block;font-size:48rpx;font-weight:700;color:#fff;margin-bottom:16rpx}.subtitle{display:block;font-size:28rpx;color:rgba(255,255,255,0.90196)}.notice{background:rgba(255,255,255,.2);-webkit-backdrop-filter:blur(10rpx);backdrop-filter:blur(10rpx);border-radius:16rpx;padding:24rpx 30rpx;margin-bottom:40rpx;border:1rpx solid rgba(255,255,255,.3)}.notice-text{display:block;font-size:24rpx;color:#fff;line-height:1.6}.plans-container{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;gap:30rpx;margin-bottom:60rpx}.plan-card{position:relative;background:#ffffff;border-radius:24rpx;padding:40rpx;-webkit-box-shadow:0 8rpx 32rpx rgba(0,0,0,.1);box-shadow:0 8rpx 32rpx rgba(0,0,0,0.10196);-webkit-transition:all .3s ease;transition:all .3s ease;border:3rpx solid transparent}.plan-card.selected{border-color:#764ba2;-webkit-transform:translateY(-4rpx);-ms-transform:translateY(-4rpx);transform:translateY(-4rpx);-webkit-box-shadow:0 12rpx 40rpx rgba(118,75,162,.3);box-shadow:0 12rpx 40rpx rgba(118,75,162,0.30196)}.plan-card.highlight{background:-webkit-linear-gradient(315deg,#f093fb 0%,#f5576c 100%);background:linear-gradient(135deg,#f093fb 0%,#f5576c 100%)}.plan-card.highlight .plan-name,.plan-card.highlight .price,.plan-card.highlight .unit,.plan-card.highlight .quota-text,.plan-card.highlight .plan-description{color:#fff}.plan-header{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:space-between;-ms-flex-pack:justify;justify-content:space-between;margin-bottom:24rpx}.plan-name{font-size:36rpx;font-weight:700;color:#333}.badge{background:-webkit-linear-gradient(315deg,#667eea 0%,#764ba2 100%);background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);color:#fff;font-size:20rpx;padding:8rpx 20rpx;border-radius:20rpx}.plan-price{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:baseline;-ms-flex-align:baseline;align-items:baseline;margin-bottom:16rpx}.price{font-size:56rpx;font-weight:700;color:#764ba2}.unit{font-size:28rpx;color:#999;margin-left:8rpx}.plan-quota{margin-bottom:16rpx}.quota-text{font-size:32rpx;font-weight:600;color:#333}.plan-description{font-size:28rpx;color:#666}.selected-indicator{position:absolute;top:30rpx;right:30rpx;background:#07C160;color:#fff;font-size:24rpx;padding:8rpx 16rpx;border-radius:12rpx}.benefits{background:rgba(255,255,255,.95);border-radius:24rpx;padding:40rpx;margin-bottom:60rpx}.benefits-title{display:block;font-size:32rpx;font-weight:700;color:#333;margin-bottom:30rpx}.benefit-item{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;margin-bottom:24rpx}.benefit-icon{width:40rpx;height:40rpx;background:#07C160;border-radius:50%;color:#fff;font-size:24rpx;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center;margin-right:20rpx;-webkit-flex-shrink:0;-ms-flex-negative:0;flex-shrink:0}.benefit-text{font-size:28rpx;color:#666;-webkit-flex:1;-ms-flex:1;flex:1}.payment-section{background:rgba(255,255,255,.95);border-radius:24rpx;padding:40rpx;margin-bottom:60rpx}.payment-title{display:block;font-size:32rpx;font-weight:700;color:#333;margin-bottom:30rpx}.qr-container{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;-webkit-align-items:center;-ms-flex-align:center;align-items:center;padding:40rpx 0}.qr-code{width:400rpx;height:400rpx;border-radius:20rpx;-webkit-box-shadow:0 8rpx 24rpx rgba(0,0,0,.1);box-shadow:0 8rpx 24rpx rgba(0,0,0,0.10196);margin-bottom:24rpx}.qr-tip{font-size:28rpx;color:#666;margin-bottom:16rpx}.qr-price{font-size:48rpx;font-weight:700;color:#764ba2}.contact-section{background:rgba(255,255,255,.95);border-radius:24rpx;padding:40rpx;margin-bottom:60rpx}.contact-title{display:block;font-size:32rpx;font-weight:700;color:#333;margin-bottom:30rpx}.contact-info{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;margin-bottom:30rpx}.contact-label{font-size:28rpx;color:#666;margin-right:12rpx}.contact-phone{font-size:32rpx;font-weight:700;color:#764ba2}.copy-button{width:100%;height:88rpx;background:-webkit-linear-gradient(315deg,#667eea 0%,#764ba2 100%);background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);color:#fff;font-size:32rpx;border-radius:44rpx;border:none;margin-bottom:20rpx}.copy-info-button{width:100%;height:88rpx;background:#ffffff;color:#764ba2;font-size:28rpx;border:2rpx solid #764ba2;border-radius:44rpx}.notice{background:rgba(255,255,255,.9);border-radius:24rpx;padding:40rpx}.notice-title{display:block;font-size:28rpx;font-weight:700;color:#333;margin-bottom:24rpx}.notice-item{display:block;font-size:26rpx;color:#999;line-height:1.8;margin-bottom:8rpx}
