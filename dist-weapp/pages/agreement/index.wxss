.policy-page{min-height:100vh;background:#f5f5f5}.policy-header{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:space-between;-ms-flex-pack:justify;justify-content:space-between;padding:20rpx 16rpx;background:#fff;position:-webkit-sticky;position:sticky;top:0;z-index:10;-webkit-box-shadow:0 2rpx 8rpx rgba(0,0,0,.05);box-shadow:0 2rpx 8rpx rgba(0,0,0,0.05098)}.policy-back{width:40rpx;height:40rpx;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center}.policy-title{font-size:18rpx;font-weight:600;color:#333}.policy-content{padding:20rpx 16rpx;height:calc(100vh - 80rpx)}.policy-section{margin-bottom:32rpx}.policy-section-title{font-size:18rpx;font-weight:600;color:#333;margin-bottom:12rpx;display:block}.policy-text{font-size:14rpx;color:#666;line-height:1.8;margin-bottom:12rpx;display:block}.policy-footer{padding:32rpx 0;border-top:1rpx solid #eee;margin-top:32rpx}.policy-footer-text{font-size:12rpx;color:#999;text-align:center;display:block;margin-bottom:8rpx}
